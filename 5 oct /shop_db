CREATE database shop_db;
USE shop_db;
CREATE TABLE products (
    Product_ID INT PRIMARY KEY,
    Product_Name VARCHAR(50),
    Category VARCHAR(50),
    Price DECIMAL(10, 2),
    Stock_Quantity INT
);
